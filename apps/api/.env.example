# Copier en apps/api/.env (jamais commité) puis remplir.
# `npx nx serve api` charge ce fichier ; en production, l'hébergeur fournit ces variables.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
CORS_ORIGINS=http://localhost:4200
# true derrière un proxy ou un load balancer (adresse IP réelle pour la limitation de débit).
TRUST_PROXY=false
# Documentation OpenAPI sur /docs et /docs-json.
SWAGGER_ENABLED=true
# pretty (lisible) ou json (une ligne par entrée, pour un collecteur de logs).
LOG_FORMAT=pretty

# Supabase : `supabase status -o env` en local (API_URL, ANON_KEY, SERVICE_ROLE_KEY).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini (API Interactions).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# État des workflows de l'assistant : firestore, ou memory (développement : perdu au redémarrage).
WORKFLOW_STATE_STORE=firestore
FIREBASE_PROJECT_ID=
# Compte de service ; sans lui, GOOGLE_APPLICATION_CREDENTIALS ou l'émulateur (FIRESTORE_EMULATOR_HOST).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_DATABASE_ID=

# Un workflow au repos quitte la mémoire après ce délai (il reste persisté).
ASSISTANT_IDLE_TIMEOUT_MINUTES=30

# Limitation de débit, par personne connectée (sinon par adresse IP), sur une minute.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
THROTTLE_ASSISTANT_MESSAGE_LIMIT=20
