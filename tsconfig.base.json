{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@org/chore": ["./libs/chore/src/index.ts"],
      "@org/chore/testing": ["./libs/chore/src/testing.ts"],
      "@org/objective": ["./libs/objective/src/index.ts"],
      "@org/objective/testing": ["./libs/objective/src/testing.ts"],
      "@org/auth": ["./libs/auth/src/index.ts"],
      "@org/auth/testing": ["./libs/auth/src/testing.ts"],
      "@org/chat": ["./libs/chat/src/index.ts"],
      "@org/chat/testing": ["./libs/chat/src/testing.ts"],
      "@org/ai": ["./libs/ai/src/index.ts"],
      "@org/ai/testing": ["./libs/ai/src/testing.ts"],
      "@org/supabase": ["./libs/supabase/src/index.ts"],
      "@org/gemini": ["./libs/gemini/src/index.ts"],
      "@org/firebase": ["./libs/firebase/src/index.ts"],
      "@org/ai-assistant": ["./workflows/ai-assistant/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
